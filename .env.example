# =============================================================================
# hokagecreativelabs-v2 — environment template
# Copy to .env.local and fill values. Never commit .env.local.
# =============================================================================
#
# FACT CHECK (current codebase): grep shows zero process.env usage in app code.
# Contact form uses mailto: only — no API route yet. Vars below are for:
#   (A) Planned features (Resend contact API)
#   (B) Academy app pulled from Vercel — UNUSED in this marketing repo unless
#       you add auth/payments/courses code here
# =============================================================================

# --- Marketing site (recommended) ---
NEXT_PUBLIC_SITE_URL=https://hokagecreativelabs.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/hokagecreativelabs001/30mins

# --- Resend (contact / transactional email — NOT wired in code yet) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hokage Creative Labs <onboarding@yourdomain.com>
CONTACT_TO_EMAIL=info@hokagecreativelabs.com
# Only if you add inbound/webhook handlers:
RESEND_WEBHOOK_SECRET=

# --- HCL Academy / learn.hokagecreativelabs.com (from Vercel — unused in v2 marketing app) ---
NEXT_PUBLIC_APP_URL=https://learn.hokagecreativelabs.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
